{
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.45",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "workerd": "1.20261021.1",
    "wrangler": "^4.151.3"
  },
  "name": "suki-get",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "deploy": "npm run build && wrangler deploy",
    "dev": "vite dev --port 8787",
    "format": "prettier --write src/ scripts/ *.js *.json vite.config.ts README.md",
    "format:check": "prettier --check src/ scripts/ *.js *.json vite.config.ts README.md",
    "lint": "eslint src/ scripts/ vite.config.ts",
    "lint:fix": "npm run lint -- --fix",
    "start": "workerd serve dist/docker/config.capnp --directory-path static=dist/docker/public",
    "type-check": "npm run generate-routes && tsc --noEmit",
    "build": "vite build",
    "build:docker": "npm run build && node scripts/build-workerd.mjs",
    "preview": "vite preview",
    "generate-routes": "tsr generate"
  },
  "type": "module",
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true,
    "workerd@1.20261019.1": true,
    "workerd@1.20261021.1": true,
    "fsevents@2.3.3": true
  }
}
